 #include <windows.h>
-#ifndef snprintf
-#define snprintf _snprintf
+#include <time.h>
+#ifndef CLOCK_REALTIME
+#define CLOCK_REALTIME 0
+static __inline int uxplay_clock_gettime(int clock_id, struct timespec *ts)
+{
+    FILETIME file_time;
+    ULARGE_INTEGER ticks;
+    (void) clock_id;
+    GetSystemTimePreciseAsFileTime(&file_time);
+    ticks.LowPart = file_time.dwLowDateTime;
+    ticks.HighPart = file_time.dwHighDateTime;
+    ticks.QuadPart -= 116444736000000000ULL;
+    ts->tv_sec = (time_t) (ticks.QuadPart / 10000000ULL);
+    ts->tv_nsec = (long) ((ticks.QuadPart % 10000000ULL) * 100ULL);
+    return 0;
+}
+#define clock_gettime uxplay_clock_gettime
 #endif
 #else
 #include <sys/types.h>
